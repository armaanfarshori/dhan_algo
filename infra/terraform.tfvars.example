# Copy to terraform.tfvars and fill in — NEVER commit terraform.tfvars to git
# cp terraform.tfvars.example terraform.tfvars

aws_region          = "ap-south-1"
project             = "dhan-trading"
env                 = "prod"

# Generate with: ssh-keygen -t ed25519 -f ~/.ssh/dhan_trading_key
# Then: cat ~/.ssh/dhan_trading_key.pub
ssh_public_key      = "ssh-ed25519 AAAA... your-key-here"

# Instance sizing
db_instance_type    = "t4g.medium"     # 4GB RAM — change to t4g.large for 8GB
agent_instance_type = "t4g.micro"      # t4g.small during free trial

# Storage
db_disk_gb          = 200

# Credentials — also stored in SSM
db_password         = "change-me-strong-password"
dhan_client_id      = "YOUR_DHAN_CLIENT_ID"
dhan_access_token   = "YOUR_DHAN_ACCESS_TOKEN..."
dhan_totp_secret    = "YOUR_BASE32_TOTP_SECRET..."
dhan_pin            = "YOUR_DHAN_PIN"
