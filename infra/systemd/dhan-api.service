[Unit]
Description=DhanAIBot dashboard API (reads DB + trader heartbeat — no order flow)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=dhan-alert@%n.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/dhan-trading
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dhan-trading/.venv/bin/python3 -m apps.api
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=append:/var/log/dhan/api.log
StandardError=append:/var/log/dhan/api.log

[Install]
WantedBy=multi-user.target
