[Unit]
Description=DhanAIBot trading platform (main.py — ORB + Kronos, paper mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/dhan-trading
Environment=PYTHONUNBUFFERED=1
# main.py loads /opt/dhan-trading/.env itself via load_dotenv()
ExecStart=/opt/dhan-trading/.venv/bin/python3 main.py
Restart=on-failure
RestartSec=10
# Graceful shutdown: main.py traps SIGTERM (squares off paper positions,
# logs run stop). Never SIGKILL a trading process before the grace expires.
KillSignal=SIGTERM
TimeoutStopSec=30
# /tmp is sticky + fs.protected_regular blocks systemd's root-side open there,
# so the real file lives in /var/log/dhan (LogsDirectory creates it owned by
# ubuntu). /tmp/platform.log is a symlink to it — operators and Hermes skills
# keep tailing the path they know. Also: journalctl -u dhan-platform
LogsDirectory=dhan
StandardOutput=append:/var/log/dhan/platform.log
StandardError=append:/var/log/dhan/platform.log

[Install]
WantedBy=multi-user.target
