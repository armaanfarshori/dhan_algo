# ── Dhan API credentials ──────────────────────────────────────────────────────
# Get from: https://dhanhq.co/developer/
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here
DHAN_PIN=                           # optional: for auto TOTP login
DHAN_TOTP_SECRET=                   # optional: base32 TOTP secret

# ── Trading mode ──────────────────────────────────────────────────────────────
PAPER_TRADING=true                  # set false only with a whitelisted Elastic IP
STRATEGY=scalper                    # scalper | sma | orb

# ── Risk controls ─────────────────────────────────────────────────────────────
MAX_DAILY_LOSS=5000                 # INR — agent halts if exceeded
CAPITAL=100000                      # total capital allocated (INR)
RISK_PER_TRADE=0.01                 # fraction of capital risked per trade

# ── ORB strategy ──────────────────────────────────────────────────────────────
ORB_RANGE_MINUTES=15                # opening range duration (15 or 30)

# ── Watchlist ──────────────────────────────────────────────────────────────────
# DYNAMIC: at market open the Kronos screener picks the top N most volatile
# NSE equities by ATR%. ORB strategies run on those, not a static list.
# WATCHLIST_N controls how many securities the screener picks (default 5).
# WATCHLIST_SECURITY_IDS is a FALLBACK used only when the instruments table
# is empty (i.e. before backfill has run). Remove or leave commented once loaded.
WATCHLIST_N=5
# WATCHLIST_SECURITY_IDS=2885,1333,1594,11536   # fallback only
WATCHLIST_EXCHANGE_SEGMENT=NSE_EQ

# ── TimescaleDB (local Docker) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dhan_trading
DB_USER=trader
DB_PASSWORD=trader123

# ── Hermes orchestrator (Groq LLM — NOT Anthropic) ───────────────────────────
# Get key at: console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=groq/llama-3.3-70b-versatile

# ── Kronos foundation model ────────────────────────────────────────────────────
# Models are auto-downloaded from HuggingFace on first run (~300MB for Kronos-small)
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
KRONOS_MODEL=NeoQuasar/Kronos-small     # swap to Kronos-mini for CPU-only
KRONOS_LOOKBACK=400                     # candles of history fed to the model (max 512)
KRONOS_PRED_LEN=30                      # candles to forecast ahead
KRONOS_SAMPLES=5                        # sampling paths (higher = better confidence estimate)
KRONOS_THRESH=0.001                     # min forecasted return to emit BUY/SELL (0.1%)
