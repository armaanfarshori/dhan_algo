# DhanAIBot environment template
#
# RULE: only set what you MUST. Every value here shadows a default in
# config.py forever — stale .env overrides have silently pinned old risk
# and model parameters twice. Tunables are listed commented-out with their
# config.py defaults; uncomment only to deliberately diverge.

# ── Dhan API credentials (REQUIRED) ───────────────────────────────────────────
# Get from: https://dhanhq.co/developer/
DHAN_CLIENT_ID=your_client_id_here
# Bootstrap/seed token only. With PIN+TOTP set, the platform auto-generates and
# rotates the live token into dhan_token.json (a runtime cache) — it is NOT
# written back here. Without TOTP, this seed is your only token (~24h life).
DHAN_ACCESS_TOKEN=your_access_token_here
DHAN_PIN=                           # enables auto token refresh (recommended)
DHAN_TOTP_SECRET=                   # base32 TOTP secret (recommended)

# ── Dhan egress proxy (only if this box's public IP is not the whitelisted one) ─
# Dhan whitelists ONE static public IP for ORDER PLACEMENT. A CGNAT home line
# has no stable egress, so orders are routed through an HTTP proxy on a host
# whose IP is whitelisted (tinyproxy on a cloud VM, reached over Tailscale).
# Unset = direct egress for everything (default; correct on a whitelisted box).
# DHAN_PROXY_URL=http://<tailscale-ip-of-egress-vm>:8888
# Which REST rate categories take the proxy. Data/quote/historicals and the
# WebSocket feed work from any IP and are far heavier — keep them direct.
# Use `all` only if the whole Dhan egress must be pinned.
# DHAN_PROXY_CATEGORIES=orders      # comma-separated; or `all`
# (blank with a proxy URL set falls back to `orders` + logs a WARNING — a proxy
#  that routes nothing would send orders out of the un-whitelisted IP)
# Expected public IP when egressing via the proxy — read ONLY by
# scripts/egress_check.py, which alerts if the proxy dies or gets re-IP'd.
# Put the REAL value in the local .env only; never commit it.
# DHAN_WHITELISTED_EGRESS_IP=<public-ip-whitelisted-at-dhan>

# ── TimescaleDB (REQUIRED) ────────────────────────────────────────────────────
DB_HOST=localhost                   # single-host deploy: the local Docker DB
# DB journalling is ON whenever DB_HOST is set — localhost included (the old
# localhost-means-dev heuristic is gone). Set false ONLY on a box with no DB
# at all, to skip the one connect-failure warning at startup.
# JOURNAL_DB_ENABLED=true
DB_PORT=5432
DB_NAME=dhan_trading
DB_USER=trader
DB_PASSWORD=trader123

# ── Telegram alerts (recommended) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AWS (agent only) ──────────────────────────────────────────────────────────
S3_BUCKET=                          # e.g. dhan-trading-data-<account-id>

# ── Dashboard security ────────────────────────────────────────────────────────
# Shared secret for POST control endpoints (/api/killswitch, /api/watchlist/refresh).
# Unset = unprotected (fail-open — never locked out of the kill-switch by misconfiguration).
# Set in production: generate with `openssl rand -hex 32`.
DASHBOARD_TOKEN=
# SEC-09: HMAC secret for Dhan postback webhook verification.
# Unset = accept all postbacks (back-compat). Set to verify X-Dhan-Signature header.
# Generate with: openssl rand -hex 32
DHAN_WEBHOOK_SECRET=
# Bind address for the dashboard HTTP server (aiohttp TCPSite).
# Default 0.0.0.0 preserves Tailscale-direct access (dashboard is reached on
# the Tailscale interface IP e.g. 100.x.x.x:8765 — 127.0.0.1 would break that).
# Set to 127.0.0.1 to restrict to localhost/SSH-tunnel access only.
API_BIND_HOST=0.0.0.0

# ── Trading mode ──────────────────────────────────────────────────────────────
PAPER_TRADING=true
# Going live requires BOTH flags + a restart — never one request away:
# ALLOW_LIVE_TOGGLE=true

# ── Risk — all limits are FRACTIONS of equity (see config.py) ────────────────
# CAPITAL=100000                    # live starting capital (₹)
# PAPER_BALANCE=500000              # paper starting equity (₹)
# RISK_PER_TRADE=0.005              # 0.5% of equity at risk per trade
# MAX_DAILY_LOSS_PCT=0.02           # 2% — halt + flatten for the day
# WEEKLY_LOSS_PCT=0.05              # 5% — halt until next week
# MAX_NOTIONAL_PER_TRADE_PCT=0.20
# MAX_GROSS_EXPOSURE_PCT=1.00
# ADV_PARTICIPATION_PCT=0.01
# MIN_STOP_DISTANCE_PCT=0.0035
# LIVE_RISK_SCALE=0.5               # live mode halves every fraction

# ── Strategy / screener ───────────────────────────────────────────────────────
# STRATEGY=orb
# ORB_RANGE_MINUTES=15
# WATCHLIST_N=5
# WATCHLIST_EXCHANGE_SEGMENT=NSE_EQ
# SCREENER_MIN_PRICE=50             # ₹ floor — penny stocks fake paper fills
# SCREENER_MIN_AVG_VOLUME=50000

# ── Backfill paths ────────────────────────────────────────────────────────────
# Override only if you run backfill.py from a non-standard location.
# Defaults match the agent's on-disk layout (/opt/dhan-trading).
# BACKFILL_CHECKPOINT_PATH=/opt/dhan-trading/backfill_ckpt_NSE_EQ.json
# BACKFILL_LOG_PATH=/tmp/backfill.log

# ── Kronos gate (defaults follow the paper — arXiv:2508.02739) ────────────────
# KRONOS_MODEL=NeoQuasar/Kronos-small
# KRONOS_TIMEFRAME=5min             # NSE pre-training granularity
# KRONOS_LOOKBACK=480               # bars at KRONOS_TIMEFRAME (max context 512)
# KRONOS_PRED_LEN=6                 # 6×5min = 30-min horizon
# KRONOS_SAMPLES=10
# KRONOS_TEMPERATURE=0.6
# KRONOS_SHADOW_MODE=true           # set false ONLY after calibration (n≥30, acc≥55%)
# KRONOS_SCANNER_ENABLED=true
# KRONOS_CHECKPOINT=                # S3 path after fine-tuning; empty = HF zero-shot
# SEC-11: pin KRONOS_REVISION to a specific HuggingFace commit hash in production
# so the model cannot change silently between restarts (e.g. KRONOS_REVISION=abc1234).
# KRONOS_REVISION=
